FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
SQLALCHEMY_DATABASE_URI=sqlite:///blockscore.db
REDIS_URL=redis://localhost:6379/0
BCRYPT_LOG_ROUNDS=12
MFA_ENCRYPTION_KEY=change-me-in-production
SMS_PROVIDER_URL=
SMS_API_KEY=

# --- Blockchain integration ---
# See code/blockchain/README.md and scripts/deploy.js for how these are
# produced. BLOCKCHAIN_FROM_ADDRESS must hold CREDIT_PROVIDER_ROLE on the
# deployed CreditScoreV2 contract or submit_credit_score_update()/
# record_payment() calls will revert.
BLOCKCHAIN_PROVIDER_URL=http://localhost:8545
BLOCKCHAIN_NETWORK_ID=1337
BLOCKCHAIN_NETWORK_NAME=development
BLOCKCHAIN_FROM_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
CREDIT_SCORE_CONTRACT_ADDRESS=
LOAN_AGREEMENT_CONTRACT_ADDRESS=
GOVERNANCE_CONTRACT_ADDRESS=
# Only needed if code/blockchain isn't a sibling directory on this
# filesystem (e.g. a Dockerized backend) - see the comment on
# CONTRACT_ARTIFACTS_PATH in config.py.
CONTRACT_ARTIFACTS_PATH=

AI_MODEL_URL=http://localhost:5001
AI_MODEL_API_KEY=
AI_MODEL_TIMEOUT=5
AI_MODEL_RETRIES=2
AI_MODEL_FAILURE_THRESHOLD=3
AI_MODEL_COOLDOWN_SECONDS=30
